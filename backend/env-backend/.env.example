# Copy to .env and fill in. Never commit .env. Server secrets never go in the mobile app.
# The server validates this file at startup and prints only the NAMES of missing/invalid values, never the values.

# ---- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# PostgreSQL connection string (use a dedicated low-privilege role in production)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shree_hari?schema=public"
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Comma-separated origins allowed to call the API (Expo web dev server by default)
CORS_ORIGINS=http://localhost:8081
# Public base URL of this API (used for uploaded-file links and webhook documentation)
PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=uploads

# ---- Auth -------------------------------------------------------------------
# POC only: lets the app sign in as the seeded demo customer. MUST be false in production (startup refuses otherwise).
ENABLE_DEMO_LOGIN=true
# Max signup/login/forgot-password/otp requests per minute per IP
AUTH_RATE_LIMIT_PER_MIN=10

# Order placements per minute per IP
CHECKOUT_RATE_LIMIT_PER_MIN=20

# Staff (admin panel) sign-in attempts per IP per 15 minutes
ADMIN_LOGIN_RATE_LIMIT=8

# ---- Reverse geocoding (GPS -> address) -------------------------------------
# none = API answers 501 GEOCODER_NOT_CONFIGURED (never invents an address). google = Google Geocoding API.
GEOCODER_PROVIDER=none
# Server-side key, restricted to the Geocoding API and to this server's IP. Required when GEOCODER_PROVIDER=google.
GOOGLE_MAPS_API_KEY=

# ---- OTP / SMS --------------------------------------------------------------
# none = disabled (503). dev = code is returned to the caller and logged (refused in production). twilio = real SMS.
OTP_PROVIDER=none
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_HOURLY_LIMIT=5
# Required when OTP_PROVIDER=twilio. For India, a DLT-registered sender/template is also required by carriers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Email (password reset) -------------------------------------------------
# none = disabled (503, no false "email sent"). dev = in-memory outbox (refused in production). resend = Resend.
EMAIL_PROVIDER=none
EMAIL_FROM="Shree Hari <no-reply@your-verified-domain.example>"
RESEND_API_KEY=
# Base of the link inside the reset email (deep link or web page that accepts ?token=)
APP_RESET_URL_BASE=shreehari://reset-password
RESET_TOKEN_TTL_MINUTES=30

# ---- Marketing messages (admin panel broadcasts) ----------------------------
# Each channel stays off until its provider is connected; the panel then refuses to send and records nothing as sent.
# Marketing push/SMS/WhatsApp only reaches customers who opted in.
NOTIFY_PUSH_PROVIDER=none        # none | expo
NOTIFY_SMS_PROVIDER=none         # none | twilio (reuses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER; India needs DLT registration)
NOTIFY_WHATSAPP_PROVIDER=none    # none | twilio (needs TWILIO_WHATSAPP_FROM and WhatsApp-approved templates)
TWILIO_WHATSAPP_FROM=            # e.g. whatsapp:+14155238886

# ---- Payments ---------------------------------------------------------------
# none = online payment disabled (COD only). razorpay = Razorpay (use rzp_test_ keys for sandbox).
# "test" exists for automated tests only and is refused in production.
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the Razorpay webhook (Dashboard > Webhooks). Webhook URL: {PUBLIC_URL}/api/webhooks/payments
RAZORPAY_WEBHOOK_SECRET=
# Unpaid online orders older than this are cancelled and their stock released (npm run jobs:expire-payments)
PAYMENT_PENDING_TTL_MINUTES=30
