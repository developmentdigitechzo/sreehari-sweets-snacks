{
  "name": "shree-hari-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Shree Hari Sweets & Snacks API (Express + TypeScript + PostgreSQL via Prisma)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "test": "node --env-file=.env.test --import tsx --test src/modules/pricing/pricing.test.ts src/modules/auth/password.test.ts src/modules/otp/otp.test.ts src/modules/payments/payments.test.ts src/modules/geocode/geocode.test.ts src/config/env.test.ts src/middleware/rateLimits.test.ts src/modules/email/email.test.ts src/modules/admin/admin.test.ts src/modules/admin/csvImport.test.ts src/modules/orders/slots.test.ts src/modules/otp/signupToken.test.ts src/modules/sync/sync.test.ts src/modules/notify/transactionalPush.test.ts src/modules/catalog/imageUrls.test.ts src/modules/auth/validators.test.ts",
    "test:integration": "node --import tsx --test src/integration/api.integration.test.ts",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "lint:fix": "node node_modules/eslint/bin/eslint.js . --fix",
    "jobs:expire-payments": "node --env-file=.env --import tsx src/jobs/expirePayments.ts",
    "test:flows": "node --import tsx --test src/integration/flows.integration.test.ts",
    "admin:create": "node dist/src/jobs/createAdmin.js",
    "jobs:send-scheduled": "node --env-file=.env --import tsx src/jobs/sendScheduled.ts",
    "test:admin": "node --import tsx --test src/integration/admin.integration.test.ts",
    "test:verify": "node --import tsx --test src/integration/verify.integration.test.ts",
    "db:check": "node --env-file=.env --import tsx src/jobs/dbCheck.ts",
    "test:workflows": "node --import tsx --test src/integration/workflows.integration.test.ts",
    "test:integration:all": "node scripts/run-integration.cjs",
    "test:regression": "node scripts/run-integration.cjs regression",
    "test:sync": "node --import tsx --test src/integration/sync.integration.test.ts",
    "admin:create:prod": "node dist/src/jobs/createAdmin.js",
    "jobs:send-scheduled:prod": "node dist/src/jobs/sendScheduled.js",
    "jobs:expire-payments:prod": "node dist/src/jobs/expirePayments.js",
    "admin:create:dev": "node --env-file=.env --import tsx src/jobs/createAdmin.ts",
    "db:probe": "node scripts/dbprobe.cjs",
    "catalog:import": "node scripts/import-catalog.cjs",
    "catalog:import:dry": "node scripts/import-catalog.cjs --dry"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
