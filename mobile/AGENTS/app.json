{
  "expo": {
    "name": "Shree Hari Sweets & Snacks",
    "slug": "shree-hari-sweets-snacks",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "shreehari",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shreehari.sweets.poc",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shreehari.sweets.poc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Shree Hari Sweets & Snacks",
      "shortName": "Shree Hari",
      "description": "Authentic Indian sweets, savouries, cakes and snacks delivered fresh.",
      "themeColor": "#B00713",
      "backgroundColor": "#FCFBF7"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#B00713",
          "resizeMode": "contain",
          "imageWidth": 280
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Shree Hari uses the camera only when you tap Camera to take a profile photo. The photo stays on your phone until you confirm it.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shree Hari uses your location once, only when you tap Use current location, to fill in your delivery address.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Shree Hari uses the microphone only while you tap the mic in the search box, to turn your voice into a search. Nothing is recorded or saved.",
          "speechRecognitionPermission": "Shree Hari uses speech recognition only to turn what you say into a search.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B00713"
        }
      ]
    ],
    "owner": "digitechzo",
    "extra": {
      "eas": {
        "projectId": "0da76a11-1088-41c7-b0e9-c2ee6c774b9a"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#B00713"
    }
  }
}
