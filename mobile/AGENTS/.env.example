# Copy the files you need: .env (shared), .env.development, .env.production. Full guide: docs/ENVIRONMENTS.md
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone: NEVER put secrets here.

## .env (all environments)
# true = demo data on the device, no backend. false = use the backend.
EXPO_PUBLIC_USE_MOCK=false
# Map preview provider. "none" = no map preview (manual address entry stays available).
EXPO_PUBLIC_MAP_PROVIDER=none

## .env.development (npm start, Expo Go, development builds) - normally nothing is needed:
## the app uses the computer running `npm start` on port 4000 automatically.
# EXPO_PUBLIC_API_PORT=4000
# EXPO_PUBLIC_API_URL_LOCAL=http://{host}:4000/api

## .env.production (release builds) - required
EXPO_PUBLIC_API_URL_PRODUCTION=https://api.example.com/api

## Forces one address in every environment (one-off testing or CI). Leave unset normally.
# EXPO_PUBLIC_API_URL=
