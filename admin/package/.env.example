# Copy to .env.development (npm run dev) and .env.production (npm run build / npm start). Real environment variables override these files.
# Server-side only (never exposed to the browser). Base URL of the Shree Hari API, including /api.
API_URL=http://localhost:4000/api
# true when the panel is served over https (marks the session cookie Secure); false for local http.
COOKIE_SECURE=false
